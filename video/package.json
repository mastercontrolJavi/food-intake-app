{
  "name": "intake-film",
  "version": "1.0.0",
  "private": true,
  "description": "30-second 2K60 product film for Intake, built in Remotion from the app's real tokens and components.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "fixtures": "cd .. && npx tsx video/scripts/build-fixtures.ts",
    "audio": "python3 scripts/make-audio.py",
    "still": "remotion still",
    "preview": "remotion render Film16x9 out/preview-animatic.mp4 --codec=h264 --crf=23 --scale=0.5 --every-nth-frame=2",
    "render:16x9": "remotion render Film16x9 out/film-16x9-2k60.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:9x16": "remotion render Film9x16 out/film-9x16-2k60.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "render:master": "remotion render Film16x9 out/film-16x9-master.mov --codec=prores --prores-profile=hq",
    "render": "npm run render:16x9 && npm run render:9x16 && npm run render:master",
    "timing": "tsx scripts/timing-report.ts",
    "cover": "remotion still Cover16x9 out/cover/intake-film-cover-16x9.png && remotion still Cover4x3 out/cover/intake-film-cover-4x3.png && remotion still Cover16x9 out/cover/intake-film-cover-16x9.jpg --image-format=jpeg --jpeg-quality=92 && remotion still Cover4x3 out/cover/intake-film-cover-4x3.jpg --image-format=jpeg --jpeg-quality=92"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/tailwind-v4": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "remotion": "4.0.533",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/webpack": "4.3.3"
  }
}
